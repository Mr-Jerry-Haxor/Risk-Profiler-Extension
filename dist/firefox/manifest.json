{
  "manifest_version": 3,
  "name": "Risk Profiler Review and Validate Automation",
  "version": "1.3",
  "description": "Risk Profiler Assessment Review and Validation Engine",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://cairois.web.boeing.com/*",
    "https://service-gateway.tas-phx.apps.boeing.com/*",
    "https://termbank.web.boeing.com/*",
    "https://esats.web.boeing.com/*",
    "https://gtc-ecm.web.boeing.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "https://cairois.web.boeing.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cairois.web.boeing.com/*"
      ],
      "js": [
        "cairoSurvey.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "service_worker.bundle.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Risk Profiler Review and Validate Automation",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "Risk Profiler Review and Validate Automation",
    "default_panel": "popup.html?view=side-pane",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "risk-profiler-review-validator@boeing.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
